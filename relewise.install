<?php

use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Entity\EntityTypeInterface;

/**
 * Implements hook_schema().
 */
function relewise_schema() {
  $schema['relewise_queue'] = [
    'description' => 'Relewise indexing queue.',
    'fields' => [
      'entity_type_id' => [
        'type' => 'varchar_ascii',
        'length' => EntityTypeInterface::ID_MAX_LENGTH,
        'not null' => TRUE,
      ],
      'entity_id' => [
        'type' => 'varchar_ascii',
        'length' => EntityTypeInterface::ID_MAX_LENGTH,
        'not null' => TRUE,
      ],
      'timestamp' => [
        'type' => 'int',
        'not null' => TRUE,
      ],
    ],
    'primary key' => ['entity_type_id', 'entity_id'],
  ];

  return $schema;
}

/**
 * Create new index queue table.
 */
function relewise_update_9001(&$sandbox) {
  $schema = \Drupal::database()->schema();
  $table_schema = relewise_schema();
  $schema->createTable('relewise_queue', $table_schema['relewise_queue']);
}

/**
 * Register any missing entity indexer and Relewise index definitions.
 */
function relewise_update_9002() {
  $entity_type_manager = \Drupal::entityTypeManager();
  $entity_type_manager->clearCachedDefinitions();
  $update_manager = \Drupal::entityDefinitionUpdateManager();

  foreach (['entity_indexer', 'relewise_index'] as $entity_type_id) {
    if (!$update_manager->getEntityType($entity_type_id)) {
      $update_manager->installEntityType($entity_type_manager->getDefinition($entity_type_id));
    }
  }
}

/**
 * Discard incomplete translation project metadata for Relewise Autocomplete.
 */
function relewise_update_9003() {
  if (\Drupal::moduleHandler()->moduleExists('locale')) {
    // Drupal 11.4 introduced the repository service and requires a project type.
    // The old autocomplete hook could cache a project without that metadata.
    $repository = \Drupal::hasService(\Drupal\locale\LocaleProjectRepository::class)
      ? \Drupal::service(\Drupal\locale\LocaleProjectRepository::class)
      : \Drupal::service('locale.project');
    $repository->deleteMultiple(['relewise_autocomplete']);
  }
}
