<?php

use Drupal\Core\Entity\Display\EntityViewDisplayInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Site\Settings;
use Drupal\user\UserInterface;

/**
 * Implements hook_locale_translation_projects_alter().
 */
function relewise_locale_translation_projects_alter(&$projects) {
  $module_handler = \Drupal::service('module_handler');
  $path = $module_handler->getModule('relewise')->getPath();
  $projects['relewise']['info']['interface translation server pattern'] = $path . '/translations/%language.po';
}

/**
 * Implements hook_entity_view_alter() for viewed entities.
 */
function relewise_entity_view_alter(array &$build, EntityInterface $entity, EntityViewDisplayInterface $display) {
  if ($entity->isNew() || isset($entity->in_preview)) {
    return;
  }

  /** @var \Drupal\relewise\RelewiseTracker $relewiseTracker */
  $relewiseTracker = \Drupal::service('relewise.tracker');
  if ($relewiseTracker->isSelectedForTracking($entity)) {
    // Add tracking library and settings, so we can track the content being viewed
    if ($display->getOriginalMode() === 'full') {
      // When the window's "load" event is triggered, mark the node as read.
      // This still allows for Drupal behaviors (which are triggered on the
      // "DOMContentReady" event) to add "new" and "updated" indicators.
      $build['#attached']['library'][] = 'relewise/entity-view';
      $build['#attached']['drupalSettings']['relewise']['entityViewed'][$relewiseTracker->getTrackingId($entity)] = TRUE;
    }
  }
}

/**
 * Implements hook_entity_insert() for new entities.
 */
function relewise_entity_insert(EntityInterface $entity) {
  /** @var \Drupal\relewise\RelewiseIndexer $relewise */
  $relewise = \Drupal::service('relewise.indexer');
  if ($entity->getEntityTypeId() == 'relewise_index') {
    /** @var \Drupal\relewise\Entity\RelewiseIndex $relewiseIndex */
    $relewiseIndex = $entity;
    $relewise->updateRelewiseIndex($relewiseIndex);
  } elseif ($relewise->isSelectedForIndexing($entity)) {
    $relewise->addEntityToIndexQueue($entity);
    \Drupal::service('cache_tags.invalidator')->invalidateTags(['relewise_' . $entity->getEntityTypeId() . '_' . $entity->bundle()]);
  }
}

/**
 * Implements hook_entity_update() for updated entities.
 */
function relewise_entity_update(EntityInterface $entity) {
  /** @var \Drupal\relewise\RelewiseIndexer $relewise */
  $relewise = \Drupal::service('relewise.indexer');
  if ($entity->getEntityTypeId() == 'relewise_index') {
    /** @var \Drupal\relewise\Entity\RelewiseIndex $relewiseIndex */
    $relewiseIndex = $entity;
    $relewise->updateRelewiseIndex($relewiseIndex);
  } elseif ($relewise->isSelectedForIndexing($entity)) {
    //$relewise->updateEntityIndexMultiple([$entity]);
    $relewise->addEntityToIndexQueue($entity);
    \Drupal::service('cache_tags.invalidator')->invalidateTags(['relewise_' . $entity->getEntityTypeId() . '_' . $entity->bundle()]);
  }
}

/**
 * Implements hook_entity_delete() for deleted entities.
 */
function relewise_entity_delete(EntityInterface $entity) {
  /** @var \Drupal\relewise\RelewiseIndexer $relewise */
  $relewise = \Drupal::service('relewise.indexer');
  if ($entity->getEntityTypeId() == 'relewise_index') {
    /** @var \Drupal\relewise\Entity\RelewiseIndex $relewiseIndex */
    $relewiseIndex = $entity;
    $relewise->deleteRelewiseIndex($relewiseIndex);
  } elseif ($relewise->isSelectedForIndexing($entity)) {
    $relewise->deleteContentIndex($entity);
    $relewise->deleteEntityFromIndexQueue($entity);
    \Drupal::service('cache_tags.invalidator')->invalidateTags(['relewise_' . $entity->getEntityTypeId() . '_' . $entity->bundle()]);
  }
}

/**
 * Implements hook_user_login() for user logins.
 */
function relewise_user_login(UserInterface $account) {
  if (!empty(Settings::get('relewise.dataset', '')) && !empty(Settings::get('relewise.apikey', ''))) {
    /** @var \Drupal\relewise\Relewise $relewise */
    $relewise = \Drupal::service('relewise');
    $relewise->userUpdate($account);
  }
}

/**
 * Implements hook_cron().
 */
function relewise_cron() {
  /** @var \Drupal\relewise\RelewiseIndexer $relewise */
  $relewise = \Drupal::service('relewise.indexer');
  $relewise->processIndexQueue();
}
